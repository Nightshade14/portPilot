# The repo root .gitignore has broad `lib/` and `runs/` patterns (for the
# Python package layout) that also match these paths under web/. Un-ignore
# them here since this directory owns its own app/lib structure.
!/lib/
!/lib/**
!/app/runs/
!/app/runs/**
