# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas Sandbox connection string (mongodb+srv://...)
MONGODB_URI=
MONGODB_DB=portpilot

# OpenRouter (OpenAI-compatible endpoint)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick during the 0:00-0:20 smoke test; switch here if tool calling is flaky.
MODEL_ID=anthropic/claude-sonnet-4.5
MODEL_TEMPERATURE=0.1

# Store backend: "memory" until Lane B lands AtlasStore, then "atlas".
PORTPILOT_STORE=memory

# Local service ports (Lane A may allocate a free port per attempt instead).
SOURCE_PORT=5001
TARGET_PORT=8787
